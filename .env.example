# SentinelForge Environment Configuration Example
# Copy this file to .env and populate with production values. Do NOT commit .env.

# Cesium Ion personal access token for 3D globe tiles and imagery
CESIUM_ION_TOKEN=replace_with_cesium_ion_token

# Internal API authentication key for SentinelForge REST endpoints
SF_API_KEY=replace_with_internal_api_key

# API key required in the X-API-Key header for /api/nlp
NLP_API_KEY=replace_with_nlp_api_key

# Google Gemini API key for natural language command interpretation
GEMINI_API_KEY=replace_with_gemini_api_key

# Comma-separated list of allowed CORS origins for serverless endpoints
ALLOWED_ORIGINS=https://example.invalid

# PostgreSQL / PostGIS database connection URL
DATABASE_URL=replace_with_database_connection_url

# PostgreSQL password for catalog store
POSTGIS_PASSWORD=replace_with_database_password

# Mutual TLS SSL private key content for Kafka transport
KAFKA_SSL_KEY=replace_with_kafka_private_key

# Optional path to PyTorch weights for thermospheric density MLP
DENSITY_MODEL_PATH=/path/to/density_mlp.pth
